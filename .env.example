GOOGLE_API_KEY=your_google_ai_studio_key

# Point this at persistent storage in production so the embedding model is reused.
EMBEDDING_CACHE_DIR=.cache/embeddings

# Point this at persistent storage in production so the indexed knowledge base survives restarts.
VECTOR_DB_PATH=vectorstore/chroma_db

# Set to true only after the embedding model has been pre-downloaded.
EMBEDDING_LOCAL_ONLY=false
